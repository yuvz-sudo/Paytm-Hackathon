# Copy to .env and fill in what you use. Every key is optional: without one, that feature falls back gracefully.

# --- AI assistant (chat, advisor note). Without a key, routine questions are answered by the rule engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-sonnet-5-5
# openai | anthropic. Empty = whichever key is set.
LLM_PROVIDER=
LLM_MODE=llm_first
LLM_DAILY_REQUESTS=60

# --- Languages and voice (Sarvam AI): UI translation, speech-to-text, text-to-speech.
# Without it the UI stays English and "Listen" uses the browser's own voice.
SARVAM_API_KEY=
# SARVAM_DAILY_CHARS=400000

# --- Marketing posters (Gemini image model). Optional.
GEMINI_API_KEY=

# --- Database. Default is a local SQLite file. For Postgres: pip install "psycopg[binary]" and use
# DATABASE_URL=postgresql+psycopg://dukaan:dukaan@localhost:5432/dukaan
DATABASE_URL=sqlite:///./dukaan_saathi.db
MAX_OFFER_DISCOUNT_PCT=15
ACTION_TTL_HOURS=48
CHAT_RETENTION_DAYS=7

# --- Login OTP. console = log only (prototype). DEV_OTP_ECHO=true shows the code on screen; set false for real use.
SMS_PROVIDER=console
DEV_OTP_ECHO=true
# Twilio Verify (works on a Twilio trial: Console > Verify > Services > Create, copy the VA... SID):
# SMS_PROVIDER=twilio_verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
